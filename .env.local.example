# Supabase configuration.
# Get these from your Supabase Project Settings → API.

# Public Supabase URL (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key — MUST be a JWT (starts with "eyJ", three dot-separated parts).
# This is NOT your project's UUID and NOT the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace-me...

# Service-role key — SECRET. Used server-side only to auto-create storage
# buckets on first boot. Without this you must create the "book-files" and
# "book-covers" buckets manually in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me...

# Optional direct Postgres URL (used by some tooling). Not required at runtime.
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
