# ─── Public Supabase configuration ────────────────────────────────────────
# These two values are PUBLIC. The anon/publishable key is meant to be
# embedded in browser bundles — committing it adds no exposure beyond what
# happens at deploy time. Row-Level Security on the database is what makes
# this safe.
#
# SECRET values (SUPABASE_SERVICE_ROLE_KEY) MUST NOT live in this file.
# They go in Vercel → Settings → Environment Variables, or in .env.local
# (which is gitignored) for local dev.

NEXT_PUBLIC_SUPABASE_URL=https://xikgwbkqcvhrfnkcxsnr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__A4wNf42rIc0ZkRjuZQgvw_5y1oAt4h
